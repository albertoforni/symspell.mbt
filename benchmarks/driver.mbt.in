// Copied into benchmarks/generated by scripts/benchmark.py.
// Input generation, compilation, startup, and validation are outside timings.

///|
fn dictionary() -> @symspell.SymSpell {
  let result = try! @symspell.SymSpell::new()
  let _ = try! result.load_dictionary(dictionary_text)
  result
}

///|
fn consume(suggestions : Array[@symspell.Suggestion]) -> Int {
  let mut checksum = suggestions.length()
  for item in suggestions {
    checksum = checksum + item.term.length() + item.distance
  }
  checksum
}

///|
fn lookup_batch(
  dict : @symspell.SymSpell,
  queries : Array[String],
  verbosity : @symspell.Verbosity,
) -> Int {
  let mut checksum = 0
  for query in queries {
    checksum = checksum + consume(try! dict.lookup(query, verbosity~))
  }
  checksum
}

///|
fn measure(
  name : String,
  operation : () -> Int,
  operations_per_batch : Int,
  warmup_ms : Double,
  sample_ms : Double,
) -> Unit {
  let mut checksum = 0
  let warmup = @bench.monotonic_clock_start()
  while @bench.monotonic_clock_end(warmup) < warmup_ms * 1000.0 {
    checksum = checksum + operation()
  }
  collect_garbage()
  let start = @bench.monotonic_clock_start()
  let mut batches = 0
  while @bench.monotonic_clock_end(start) < sample_ms * 1000.0 {
    checksum = checksum + operation()
    batches = batches + 1
  }
  let elapsed_us = @bench.monotonic_clock_end(start)
  let operations = batches * operations_per_batch
  println("metric\t\{name}\t\{elapsed_us}\t\{operations}\t\{checksum}")
}

///|
fn validate(dict : @symspell.SymSpell) -> Unit {
  println("stat\twords\t\{dict.word_count()}")
  for
    specification in [
      ("exact_top", exact_queries, @symspell.Top),
      ("typo_top", typo_queries, @symspell.Top),
      ("typo_closest", typo_queries, @symspell.Closest),
      ("typo_all", typo_queries, @symspell.All),
      ("miss_top", miss_queries, @symspell.Top),
    ] {
    let (name, queries, mode) = specification
    for index, query in queries {
      let result = try! dict.lookup(query, verbosity=mode)
      println("query\t\{name}\t\{index}")
      for item in result {
        println(
          "word\t\{name}\t\{index}\t\{item.term}\t\{item.distance}\t\{item.count}",
        )
      }
    }
  }
  for index, query in compound_queries {
    let item = (try! dict.lookup_compound(query))[0]
    println("compound\t\{index}\t\{item.term}\t\{item.distance}\t\{item.count}")
  }
  for index, query in segmentation_queries {
    let item = try! dict.word_segmentation(query)
    println(
      "segmentation\t\{index}\t\{item.corrected_string}\t\{item.distance_sum}\t\{item.log_prob_sum}",
    )
  }
  let corpus = try! @symspell.SymSpell::new()
  let report = corpus.create_dictionary(corpus_text)
  println("stat\tcorpus_tokens\t\{report.parsed_tokens}")
  println("stat\tcorpus_words\t\{corpus.word_count()}")
  let restored = try! @symspell.SymSpell::from_snapshot(dict.to_snapshot())
  for query in typo_queries {
    if (try! restored.lookup(query)) != (try! dict.lookup(query)) {
      abort("Snapshot lookup differs")
    }
  }
  println("stat\tsnapshot_bytes\t\{dict.to_snapshot().length()}")
}

///|
fn main {
  let args = @env.args()[argument_offset():].to_owned()
  let dict = dictionary()
  if args.length() > 0 && args[0] == "memory" {
    println("stat\twords\t\{dict.word_count()}")
    return
  }
  if args.length() > 0 && args[0] == "validate" {
    validate(dict)
    return
  }
  let warmup_ms = if args.length() > 0 {
    try! @string.parse_double(args[0][:])
  } else {
    100.0
  }
  let sample_ms = if args.length() > 1 {
    try! @string.parse_double(args[1][:])
  } else {
    200.0
  }
  measure("build", () => dictionary().word_count(), 1, warmup_ms, sample_ms)
  measure(
    "corpus",
    () => {
      let corpus = try! @symspell.SymSpell::new()
      corpus.create_dictionary(corpus_text).parsed_tokens + corpus.word_count()
    },
    1,
    warmup_ms,
    sample_ms,
  )
  for
    specification in [
      ("exact_top", exact_queries, @symspell.Top),
      ("typo_top", typo_queries, @symspell.Top),
      ("typo_closest", typo_queries, @symspell.Closest),
      ("typo_all", typo_queries, @symspell.All),
      ("miss_top", miss_queries, @symspell.Top),
    ] {
    let (name, queries, mode) = specification
    measure(
      name,
      () => lookup_batch(dict, queries, mode),
      queries.length(),
      warmup_ms,
      sample_ms,
    )
  }
  measure(
    "compound",
    () => {
      let mut checksum = 0
      for query in compound_queries {
        checksum = checksum + consume(try! dict.lookup_compound(query))
      }
      checksum
    },
    compound_queries.length(),
    warmup_ms,
    sample_ms,
  )
  measure(
    "segmentation",
    () => {
      let mut checksum = 0
      for query in segmentation_queries {
        let result = try! dict.word_segmentation(query)
        checksum = checksum +
          result.corrected_string.length() +
          result.distance_sum
      }
      checksum
    },
    segmentation_queries.length(),
    warmup_ms,
    sample_ms,
  )
  let snapshot = dict.to_snapshot()
  println("stat\tsnapshot_bytes\t\{snapshot.length()}")
  measure(
    "snapshot_save",
    () => dict.to_snapshot().length(),
    1,
    warmup_ms,
    sample_ms,
  )
  measure(
    "snapshot_restore",
    () => (try! @symspell.SymSpell::from_snapshot(snapshot)).word_count(),
    1,
    warmup_ms,
    sample_ms,
  )
}
