    ("b😀𐐀𐐀京aa東b", 0, []),
    ("b😀𐐀𐐀京aa東b", 1, []),
    ("😀京b東𐐀b東b", 0, []),
    ("😀京b東𐐀b東b", 1, []),
    ("𐐀a東東京😀b", 0, []),
    ("𐐀a東東京😀b", 1, []),
