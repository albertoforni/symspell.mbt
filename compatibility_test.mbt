      "é",
      2,
      [
        ("é𐐀", 1, 18L),
        ("b", 1, 15L),
        ("aa", 2, 28L),
        ("bb", 2, 28L),
        ("ab", 2, 27L),
        ("ba", 2, 24L),
        ("é", 2, 18L),
      ],
    ),
    ("éé京aéé", 0, []),
    ("éé京aéé", 1, []),
    ("éé京aéé", 2, [("éé京ab", 2, 28L)]),
