      ],
    ),
  ]
  for fixture in cases {
    let (query, limit, expected) = fixture
    let all = dictionary.lookup(query, verbosity=All, max_edit_distance=limit)
    assert_eq(all.map(item => (item.term, item.distance, item.count)), expected)
    let closest = if expected.is_empty() {
      []
    } else {
      expected.filter(item => item.1 == expected[0].1)
    }
    let top = if expected.is_empty() { [] } else { [expected[0]] }
    let actual_closest = dictionary.lookup(query, max_edit_distance=limit)
    let actual_top = dictionary.lookup(
      query,
      verbosity=Top,
      max_edit_distance=limit,
    )
    assert_eq(
      actual_closest.map(item => (item.term, item.distance, item.count)),
      closest,
    )
    assert_eq(
      actual_top.map(item => (item.term, item.distance, item.count)),
      top,
    )
    if expected.is_empty() {
      let fallback = dictionary.lookup(
        query,
        max_edit_distance=limit,
        include_unknown=true,
      )
      assert_eq(fallback.map(item => (item.term, item.distance, item.count)), [
        (query, limit + 1, 0L),
      ])
    }
  }
}

