        ("東a𐐀ba", 4, 24L),
        ("a東ba京", 4, 10L),
      ],
    ),
    ("é", 0, []),
    ("é", 1, [("é𐐀", 1, 18L), ("b", 1, 15L)]),
    (
      "é",
      2,
      [
        ("é𐐀", 1, 18L),
        ("b", 1, 15L),
        ("aa", 2, 28L),
        ("bb", 2, 28L),
