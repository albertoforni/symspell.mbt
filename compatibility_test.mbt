        ("bbb", 3, 20L),
        ("😀éab", 3, 13L),
        ("aab", 3, 10L),
        ("a😀bé", 3, 10L),
      ],
    ),
    (
      "é",
      4,
      [
        ("é𐐀", 1, 18L),
        ("b", 1, 15L),
        ("aa", 2, 28L),
        ("bb", 2, 28L),
        ("ab", 2, 27L),
        ("ba", 2, 24L),
        ("é", 2, 18L),
        ("é𐐀😀é", 3, 29L),
        ("👩‍💻", 3, 26L),
        ("abb", 3, 24L),
        ("bba", 3, 23L),
        ("ABC", 3, 22L),
        ("bbb", 3, 20L),
        ("😀éab", 3, 13L),
        ("aab", 3, 10L),
