///|
test "reference corpus tokenization threshold 0" {
  let dictionary = @symspell.SymSpell::new(count_threshold=0L)
  let expected = @symspell.SymSpell::new(count_threshold=0L)
  for round = 0; round < 2; round = round + 1 {
    for fixture in reference_corpus_tokens() {
      let (text, tokens) = fixture
      let mut added_words = 0
      for token in tokens {
        if expected.create_dictionary_entry(token, 1L) {
          added_words = added_words + 1
        }
      }
      assert_eq(dictionary.create_dictionary(text), {
        parsed_tokens: tokens.length(),
        added_words,
      })
      assert_eq(dictionary.to_snapshot(), expected.to_snapshot())
    }
  }
}

