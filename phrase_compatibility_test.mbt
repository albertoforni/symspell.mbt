  ]
  for fixture in fixtures {
    let (phrase, limit, window, segmented, corrected, distance, probability) = fixture
    let result = dictionary.word_segmentation(
      phrase,
      max_edit_distance=limit,
      max_segmentation_word_length=window,
    )
    assert_eq(
      (result.segmented_string, result.corrected_string, result.distance_sum),
      (segmented, corrected, distance),
    )
    assert_true((result.log_prob_sum - probability).abs() < 0.000000001)
  }
}

