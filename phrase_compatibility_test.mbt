  for fixture in fixtures {
    let (phrase, limit, window, segmented, corrected, distance, probability) = fixture
    let result = dictionary.word_segmentation(
      phrase,
      max_edit_distance=limit,
      max_segmentation_word_length=window,
    )
    assert_eq(
      (result.segmented_string, result.corrected_string, result.distance_sum),
      (segmented, corrected, distance),
    )
    assert_true((result.log_prob_sum - probability).abs() < 0.000000001)
  }
}

///|
test "reference compound english distance 2 corpus 10000 bigrams True" {
  let dictionary = @symspell.SymSpell::new(
    max_dictionary_edit_distance=2,
    prefix_length=3,
    corpus_size=10000L,
  )
  let _ = dictionary.create_dictionary_entry("a", 1000L)
  let _ = dictionary.create_dictionary_entry("is", 983L)
  let _ = dictionary.create_dictionary_entry("where", 966L)
  let _ = dictionary.create_dictionary_entry("whereas", 949L)
  let _ = dictionary.create_dictionary_entry("steam", 932L)
  let _ = dictionary.create_dictionary_entry("machine", 915L)
  let _ = dictionary.create_dictionary_entry("hello", 898L)
  let _ = dictionary.create_dictionary_entry("world", 881L)
  let _ = dictionary.create_dictionary_entry("the", 864L)
  let _ = dictionary.create_dictionary_entry("quick", 847L)
  let _ = dictionary.create_dictionary_entry("brown", 830L)
  let _ = dictionary.create_dictionary_entry("fox", 813L)
  let _ = dictionary.create_dictionary_entry("jumps", 796L)
  let _ = dictionary.create_dictionary_entry("over", 779L)
  let _ = dictionary.create_dictionary_entry("lazy", 762L)
  let _ = dictionary.create_dictionary_entry("dog", 745L)
  let _ = dictionary.create_dictionary_entry("ice", 728L)
  let _ = dictionary.create_dictionary_entry("cream", 711L)
  let _ = dictionary.create_dictionary_entry("don't", 694L)
  let _ = dictionary.create_dictionary_entry("can't", 677L)
  let _ = dictionary.create_dictionary_entry("some", 660L)
  let _ = dictionary.create_dictionary_entry("words", 643L)
  let _ = dictionary.create_dictionary_entry("members", 626L)
  let _ = dictionary.create_dictionary_entry("remember", 609L)
  let _ = dictionary.set_bigram_count("where is", 300L)
  let _ = dictionary.set_bigram_count("hello world", 347L)
  let _ = dictionary.set_bigram_count("ice cream", 394L)
  let fixtures : Array[(String, Int32, String, Int32, Int64)] = [
    ("", 0, "", 0, 10000L),
    ("", 1, "", 0, 10000L),
    ("", 2, "", 0, 10000L),
    ("unknown", 0, "unknown", 0, 0L),
    ("unknown", 1, "unknown", 0, 0L),
    ("unknown", 2, "a brown", 4, 83L),
    ("a", 0, "a", 0, 1000L),
    ("a", 1, "a", 0, 1000L),
    ("a", 2, "a", 0, 1000L),
    ("is", 0, "is", 0, 983L),
    ("is", 1, "is", 0, 983L),
    ("is", 2, "is", 0, 983L),
    ("where", 0, "where", 0, 966L),
    ("where", 1, "where", 0, 966L),
    ("where", 2, "where", 0, 966L),
    ("whereas", 0, "whereas", 0, 949L),
    ("whereas", 1, "whereas", 0, 949L),
    ("whereas", 2, "whereas", 0, 949L),
    ("steam", 0, "steam", 0, 932L),
