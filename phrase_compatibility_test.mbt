    ("東京 大阪", 1, "東京 大阪", 0, 98L),
    ("東京 大阪", 2, "東京 大阪", 0, 98L),
    ("東京大阪", 0, "東京 大阪", 1, 98L),
    ("東京大阪", 1, "東京 大阪", 1, 98L),
    ("東京大阪", 2, "東京 大阪", 1, 98L),
    ("東京x大阪", 0, "東京x大阪", 0, 0L),
    ("東京x大阪", 1, "東京 大阪", 1, 98L),
    ("東京x大阪", 2, "東京 大阪", 1, 98L),
    ("𐐨 ! 😀", 0, "𐐨 ! 😀", 0, 6L),
    ("𐐨 ! 😀", 1, "𐐨 ! 😀", 0, 6L),
    ("𐐨 ! 😀", 2, "𐐨 ! 😀", 0, 6L),
    ("𐐨! 😀", 0, "𐐨 ! 😀", 1, 6L),
    ("𐐨! 😀", 1, "𐐨 😀", 1, 77L),
    ("𐐨! 😀", 2, "𐐨 😀", 1, 77L),
    ("'x", 0, "'x", 0, 0L),
    ("'x", 1, "'s", 1, 796L),
    ("'x", 2, "'s", 1, 796L),
  ]
  for fixture in fixtures {
    let (phrase, limit, term, distance, count) = fixture
    let result = dictionary.lookup_compound(phrase, max_edit_distance=limit)
    assert_eq(result.length(), 1)
    assert_eq(
      (result[0].term, result[0].distance, result[0].count),
      (term, distance, count),
    )
  }
}

