///|
test "reference compound unicode distance 1 corpus 10000 bigrams True" {
  let dictionary = @symspell.SymSpell::new(
    max_dictionary_edit_distance=1,
    prefix_length=2,
    corpus_size=10000L,
  )
  let _ = dictionary.create_dictionary_entry("東京", 1000L)
  let _ = dictionary.create_dictionary_entry("大阪", 983L)
  let _ = dictionary.create_dictionary_entry("京都", 966L)
  let _ = dictionary.create_dictionary_entry("旅行", 949L)
  let _ = dictionary.create_dictionary_entry("café", 932L)
  let _ = dictionary.create_dictionary_entry("été", 915L)
  let _ = dictionary.create_dictionary_entry("😀", 898L)
  let _ = dictionary.create_dictionary_entry("😃", 881L)
  let _ = dictionary.create_dictionary_entry("𐐨", 864L)
  let _ = dictionary.create_dictionary_entry("ab", 847L)
  let _ = dictionary.create_dictionary_entry("abc", 830L)
  let _ = dictionary.create_dictionary_entry("!", 813L)
  let _ = dictionary.create_dictionary_entry("'s", 796L)
  let _ = dictionary.set_bigram_count("東京 旅行", 300L)
  let _ = dictionary.set_bigram_count("大阪 京都", 347L)
  let _ = dictionary.set_bigram_count("café été", 394L)
  let fixtures : Array[(String, Int32, String, Int32, Int64)] = [
    ("", 0, "", 0, 10000L),
    ("", 1, "", 0, 10000L),
    ("unknown", 0, "unknown", 0, 0L),
    ("unknown", 1, "unknown", 0, 0L),
    ("東京", 0, "東京", 0, 1000L),
    ("東京", 1, "東京", 0, 1000L),
    ("大阪", 0, "大阪", 0, 983L),
    ("大阪", 1, "大阪", 0, 983L),
    ("京都", 0, "京都", 0, 966L),
    ("京都", 1, "京都", 0, 966L),
    ("旅行", 0, "旅行", 0, 949L),
    ("旅行", 1, "旅行", 0, 949L),
    ("café", 0, "café", 0, 932L),
    ("café", 1, "café", 0, 932L),
    ("été", 0, "été", 0, 915L),
    ("été", 1, "été", 0, 915L),
    ("😀", 0, "😀", 0, 898L),
    ("😀", 1, "😀", 0, 898L),
    ("😃", 0, "😃", 0, 881L),
    ("😃", 1, "😃", 0, 881L),
    ("𐐨", 0, "𐐨", 0, 864L),
    ("𐐨", 1, "𐐨", 0, 864L),
    ("ab", 0, "ab", 0, 847L),
    ("ab", 1, "ab", 0, 847L),
