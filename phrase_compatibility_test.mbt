    ("étéabc", 0, "été abc", 1, 0L),
    ("été zabc", 0, "été zabc", 0, 0L),
    ("été 's", 0, "été 's", 0, 0L),
    ("été's", 0, "été 's", 1, 0L),
    ("été xs", 0, "été xs", 0, 0L),
    ("xs", 0, "xs", 0, 0L),
    ("京", 0, "京", 0, 0L),
    ("'", 0, "'", 0, 0L),
    ("café été", 0, "café été", 0, 0L),
    ("caféété", 0, "café été", 1, 0L),
    ("afé été", 0, "afé été", 0, 0L),
    ("'s été", 0, "'s été", 0, 0L),
    ("'sété", 0, "'s été", 1, 0L),
    ("s' été", 0, "s' été", 0, 0L),
    ("ab 's", 0, "ab 's", 0, 0L),
    ("ab's", 0, "ab 's", 1, 0L),
    ("ab z's", 0, "ab z's", 0, 0L),
    ("東京 大阪", 0, "東京 大阪", 0, 0L),
    ("東京大阪", 0, "東京 大阪", 1, 0L),
    ("東京x大阪", 0, "東京x大阪", 0, 0L),
    ("𐐨 ! 😀", 0, "𐐨 ! 😀", 0, 0L),
    ("𐐨! 😀", 0, "𐐨 ! 😀", 1, 0L),
    ("'x", 0, "'x", 0, 0L),
  ]
  for fixture in fixtures {
    let (phrase, limit, term, distance, count) = fixture
    let result = dictionary.lookup_compound(phrase, max_edit_distance=limit)
    assert_eq(result.length(), 1)
    assert_eq(
      (result[0].term, result[0].distance, result[0].count),
      (term, distance, count),
    )
  }
}

