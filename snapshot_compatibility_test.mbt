  assert_eq(dictionary.to_snapshot(), fixture)
  let restored = @symspell.SymSpell::from_snapshot(fixture)
  assert_eq(restored.to_snapshot(), fixture)
  assert_eq(restored.word_count(), dictionary.word_count())
  assert_eq(restored.pending_word_count(), dictionary.pending_word_count())
  assert_eq(restored.entry_count(), dictionary.entry_count())
  assert_eq(restored.bigram_count(), dictionary.bigram_count())
  assert_eq(
    restored.lookup("", verbosity=All),
    dictionary.lookup("", verbosity=All),
  )
  assert_eq(
    restored.lookup("a", verbosity=All),
    dictionary.lookup("a", verbosity=All),
  )
  assert_eq(
    restored.lookup("b", verbosity=All),
    dictionary.lookup("b", verbosity=All),
  )
  assert_eq(
    restored.lookup("😀", verbosity=All),
    dictionary.lookup("😀", verbosity=All),
  )
  assert_eq(
    restored.lookup("ba", verbosity=All),
    dictionary.lookup("ba", verbosity=All),
  )
  assert_eq(
    restored.lookup("cafe", verbosity=All),
    dictionary.lookup("cafe", verbosity=All),
  )
  assert_eq(
    restored.lookup("東亰", verbosity=All),
    dictionary.lookup("東亰", verbosity=All),
  )
  assert_eq(
    restored.lookup("unknown", verbosity=All),
    dictionary.lookup("unknown", verbosity=All),
  )
}

